# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=products_app
DB_PASSWORD=cambia_esta_clave
DB_NAME=products_db

# Servidor
PORT=8082
# production | development
FLASK_ENV=development
# Solo para desarrollo local. Nunca actives el modo debug en un servidor accesible desde la red.
FLASK_DEBUG=0
# Interfaz del servidor de desarrollo (python app.py). El contenedor usa gunicorn en 0.0.0.0.
HOST=127.0.0.1

# Orígenes del frontend autorizados (separados por coma). Obligatorio en producción.
# Ejemplo: CORS_ORIGINS=http://localhost,http://mi-servidor.cl
CORS_ORIGINS=

# Clave para crear, editar y eliminar productos (cabecera X-API-Key).
# Sin ella, esas rutas quedan deshabilitadas.
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=
